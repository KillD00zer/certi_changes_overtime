{
  "manifest_version": 3,
  "name": "منظومة المتغيرات المكانية - Google Earth Extension",
  "description": "أتمتة Google Earth Web لرصد المتغيرات المكانية، توقيع إحداثيات الرفع المساحي، والتقاط الصور التاريخية وإصدار تقارير المعاينة الرسمية",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "منظومة المتغيرات المكانية - Google Earth",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "sidePanel",
    "contextMenus"
  ],
  "commands": {
    "capture-map": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "التقاط خريطة Google Earth وتوثيقها فوراً"
    }
  },
  "host_permissions": [
    "<all_urls>",
    "https://earth.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://earth.google.com/*"
      ],
      "js": [
        "libs/proj4.js",
        "scripts/content_script.js"
      ],
      "css": [
        "styles/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "libs/*",
        "styles/*"
      ],
      "matches": [
        "https://earth.google.com/*"
      ]
    }
  ]
}
